      "properties": {
        "_id": { "type": "string", "maxLength": 128 },
        "return_code": { "type": "string", "maxLength": 50 },
        "business_date": { "type": "string", "maxLength": 10 },
        "warehouse_id": { "type": "string", "maxLength": 128 },
        "salesman_id": { "type": "string", "maxLength": 128 },
        "status": { "type": "string", "enum": ["DRAFT", "CONFIRMED", "CANCELLED"] },
        "notes": { "type": "string", "maxLength": 500 },
        "confirmed_by": { "type": "string", "maxLength": 128 },
        "created_by": { "type": "string", "maxLength": 128 },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["return_code", "business_date", "warehouse_id", "salesman_id", "status"]
    },
    "StockReceiving": {
      "title": "StockReceiving",
      "description": "Inbound stock receiving from suppliers/principals to warehouse",
      "type": "object",
      "properties": {
        "_id": { "type": "string", "maxLength": 128 },
        "receive_code": { "type": "string", "maxLength": 50 },
        "business_date": { "type": "string", "maxLength": 10 },
        "warehouse_id": { "type": "string", "maxLength": 128 },
        "supplier_name": { "type": "string", "maxLength": 150 },
        "status": { "type": "string", "enum": ["DRAFT", "CONFIRMED", "CANCELLED"] },
        "created_at": { "type": "string", "format": "date-time" }
      },
      "required": ["receive_code", "business_date", "warehouse_id", "status"]
    },
    "SalesStockLedger": {
      "title": "SalesStockLedger",
      "description": "Daily ledger per sales rep and SKU tracking opening balance, transfers, sales, returns, and discrepancies",
      "type": "object",
      "properties": {
        "_id": { "type": "string", "maxLength": 128 },
        "salesman_id": { "type": "string", "maxLength": 128 },
        "business_date": { "type": "string", "maxLength": 10 },
        "sku_id": { "type": "string", "maxLength": 128 },
        "opening_balance": { "type": "number" },
        "transfers_in": { "type": "number" },
        "sales_out": { "type": "number" },
        "returns_out": { "type": "number" },
        "closing_balance": { "type": "number" },
        "expected_balance": { "type": "number" },
        "discrepancy": { "type": "number" },
        "status": { "type": "string", "enum": ["BALANCED", "SURPLUS", "DEFICIT"] },
        "last_movement_id": { "type": "string", "maxLength": 128 },
        "notes": { "type": "string", "maxLength": 500 },
        "updated_at": { "type": "string", "format": "date-time" }
      },
      "required": ["salesman_id", "business_date", "sku_id", "opening_balance", "transfers_in", "sales_out", "returns_out", "closing_balance", "status"]
    },
    "Target": {
      "title": "Target",
      "description": "Sales target by period, salesman, or SKU",
      "type": "object",
      "properties": {
        "_id": { "type": "string", "maxLength": 128 },
