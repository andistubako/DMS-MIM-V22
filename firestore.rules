rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Allow read and write for application operational collections
    match /{document=**} {
      allow read, write: if true;
    }

    match /companies/{companyId} { allow read, write: if true; }
    match /system_settings/{settingId} { allow read, write: if true; }
    match /users/{userId} { allow read, write: if true; }
    match /offices/{id} { allow read, write: if true; }
    match /provinces/{id} { allow read, write: if true; }
    match /regencies/{id} { allow read, write: if true; }
    match /districts/{id} { allow read, write: if true; }
    match /villages/{id} { allow read, write: if true; }
    match /areas/{id} { allow read, write: if true; }
    match /channels/{id} { allow read, write: if true; }
    match /routes/{id} { allow read, write: if true; }
    match /salesmen/{id} { allow read, write: if true; }
    match /open_call_reasons/{id} { allow read, write: if true; }
    match /outlets/{id} { allow read, write: if true; }
    match /sales_outlets/{id} { allow read, write: if true; }
    match /products/{id} { allow read, write: if true; }
    match /skus/{id} { allow read, write: if true; }
    match /prices/{id} { allow read, write: if true; }
    match /promos/{id} { allow read, write: if true; }
    match /call_plans/{id} { allow read, write: if true; }
    match /call_plan_items/{id} { allow read, write: if true; }
    match /attendance/{id} { allow read, write: if true; }
    match /visits/{id} { allow read, write: if true; }
    match /transactions/{id} { allow read, write: if true; }
    match /audit_logs/{id} { allow read, write: if true; }
    match /inventory/{id} { allow read, write: if true; }
    match /stock_movements/{id} { allow read, write: if true; }
    match /stock_handovers/{id} { allow read, write: if true; }
    match /stock_returns/{id} { allow read, write: if true; }
    match /stock_receivings/{id} { allow read, write: if true; }
    match /sales_stock_ledgers/{id} { allow read, write: if true; }
    match /targets/{id} { allow read, write: if true; }
    match /cash_deposits/{id} { allow read, write: if true; }
    match /receivables/{id} { allow read, write: if true; }
    match /daily_reconciliations/{id} { allow read, write: if true; }
    match /gps_events/{id} { allow read, write: if true; }
  }
}

